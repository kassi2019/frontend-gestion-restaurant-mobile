{
  "expo": {
    "name": "RestoPro",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour les menus.",
          "cameraPermission": "L'application utilise l'appareil photo."
        }
      ]
    ],
    "slug": "gestion-resto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E86B2A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E86B2A"
      },
      "package": "com.fabricekassi.gestionrestomobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
